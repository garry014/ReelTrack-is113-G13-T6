<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= item.title %> - ReelTrack
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('../layout/header') %>
        <div class="container">
            <div class="card">
                <span class="badge">
                    <%= item.category %>
                </span>
                <h1>
                    <%= item.title %>
                </h1>
                <p class="price">$<%= item.price %>
                </p>
                <div style="margin: 2rem 0; border-top: 1px solid var(--border); padding-top: 1rem;">
                    <h3>Description</h3>
                    <p>
                        <%= item.description %>
                    </p>
                </div>
                <p style="color: var(--text-light);">Posted by: <%= item.owner.name %>
                </p>

                <% if (currentUser && item.owner._id.equals(currentUser._id)) { %>
                    <div style="margin-top: 2rem; display: flex; gap: 1rem;">
                        <a href="/items/<%= item._id %>/edit"><button>Edit Item</button></a>
                        <form action="/items/<%= item._id %>?_method=DELETE" method="POST">
                            <button type="submit" class="btn-delete">Delete Item</button>
                        </form>
                    </div>
                    <% } %>
            </div>
        </div>
</body>

</html>