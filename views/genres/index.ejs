<%- include('../layout/base', { pageTitle: 'All Genres' }) %>
<%- include('../layout/header') %>

<div class="container">
    <section class="movies-section">
        <span class="section-label">Browse</span>
        <h2>All Genres</h2>
        <div class="section-divider"></div>

        <% if (currentUser && currentUser.role === 'admin') { %>
            <div style="margin-bottom: 1.25rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/genres/new" class="btn btn-primary">+ Add New Genre</a>
                <a href="/genres/filter/movies" class="btn btn-ghost">Filter Movies by Genre</a>
            </div>
        <% } else { %>
            <div style="margin-bottom: 1.25rem;">
                <a href="/genres/filter/movies" class="btn btn-ghost">Filter Movies by Genre</a>
            </div>
        <% } %>

        <% if (messages.success) { %>
            <p style="color: green; margin-bottom: 1rem;"><%= messages.success %></p>
        <% } %>

        <% if (messages.error) { %>
            <p style="color: red; margin-bottom: 1rem;"><%= messages.error %></p>
        <% } %>

        <% if (allGenres.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">🏷️</div>
                <h3>No genres yet</h3>
                <p>No genres have been added yet.</p>
            </div>
        <% } else { %>
            <div class="movies-container">
                <% allGenres.forEach((genre) => { %>
                    <div class="movie-card" id="genre-<%= genre._id %>" style="display: flex; flex-direction: column; height: 100%;">
                        <a href="/genres/<%= genre._id %>" style="text-decoration: none; color: inherit; flex: 1; display: flex; flex-direction: column;">
                            <div class="movie-card-info" style="flex: 1; display: flex; flex-direction: column;">
                                <div style="display: flex; justify-content: space-between; align-items: start; gap: 0.5rem; margin-bottom: 0.5rem;">
                                    <p class="movie-card-title" style="margin: 0; font-size: 1.1rem; white-space: normal; overflow: visible;"><%= genre.name %></p>
                                    <span class="badge <%= genre.isActive ? 'badge-green' : '' %>" style="flex-shrink: 0;">
                                        <%= genre.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                </div>
                                <p class="movie-card-meta" style="flex: 1; margin-bottom: 1rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 6; line-clamp: 6; -webkit-box-orient: vertical;">
                                    <%= genre.description %>
                                </p>
                            </div>
                        </a>

                        <% if (currentUser && currentUser.role === 'admin') { %>
                            <div style="padding: 0 0.75rem 0.75rem 0.75rem; display: flex; gap: 0.5rem; margin-top: auto;">
                                <a href="/genres/<%= genre._id %>/edit" class="btn btn-warning btn-sm" style="flex: 1; justify-content: center;">Edit</a>
                                <button type="button" class="btn btn-ghost btn-sm" onclick="deleteGenre('<%= genre._id %>')" style="flex: 1; justify-content: center;">Delete</button>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>
</div>

<script>
    async function deleteGenre(id) {
        const confirmed = confirm('Are you sure you want to delete this genre?');
        if (!confirmed) return;

        const response = await fetch(`/genres/${id}`, {
            method: 'DELETE'
        });

        const result = await response.json();
        alert(result.message);
        window.location.href = result.redirect;
    }
</script>

<%- include('../layout/footer') %>