<%- include('../layout/base', { pageTitle: 'All Genres' }) %>
<%- include('../layout/header') %>

<div class="container">
    <section class="movies-section">
        <span class="section-label">Browse</span>
        <h2>All Genres</h2>
        <div class="section-divider"></div>

        <% if (currentUser && currentUser.role === 'admin') { %>
            <div style="margin-bottom: 1.25rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <a href="/genres/new" class="btn btn-primary">+ Add New Genre</a>
                <a href="/genres/filter/movies" class="btn btn-ghost">Filter Movies by Genre</a>
            </div>
        <% } else { %>
            <div style="margin-bottom: 1.25rem;">
                <a href="/genres/filter/movies" class="btn btn-ghost">Filter Movies by Genre</a>
            </div>
        <% } %>

        <% if (messages.success) { %>
            <p style="color: green; margin-bottom: 1rem;"><%= messages.success %></p>
        <% } %>

        <% if (messages.error) { %>
            <p style="color: red; margin-bottom: 1rem;"><%= messages.error %></p>
        <% } %>

        <% if (allGenres.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">🏷️</div>
                <h3>No genres yet</h3>
                <p>No genres have been added yet.</p>
            </div>
        <% } else { %>
            <div class="movies-container">
                <% allGenres.forEach((genre) => { %>
                    <div class="movie-card" id="genre-<%= genre._id %>" style="text-decoration: none;">
                        <a href="/genres/<%= genre._id %>" style="text-decoration: none; color: inherit;">
                            <div class="movie-card-info">
                                <p class="movie-card-title"><%= genre.name %></p>
                                <p class="movie-card-meta"><%= genre.description %></p>
                                <p class="movie-card-meta"><%= genre.isActive ? 'Active' : 'Inactive' %></p>
                            </div>
                        </a>

                        <% if (currentUser && currentUser.role === 'admin') { %>
                            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                                <a href="/genres/<%= genre._id %>/edit" class="btn btn-warning">Edit</a>
                                <button type="button" class="btn btn-ghost" onclick="deleteGenre('<%= genre._id %>')">Delete</button>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>
</div>

<script>
    async function deleteGenre(id) {
        const confirmed = confirm('Are you sure you want to delete this genre?');
        if (!confirmed) return;

        const response = await fetch(`/genres/${id}`, {
            method: 'DELETE'
        });

        const result = await response.json();
        alert(result.message);
        window.location.href = result.redirect;
    }
</script>

<%- include('../layout/footer') %>