<header>
    <h4><a href="/movies">ReelTrack</a></h4>
    <nav>
        <a href="/movies">Movies</a>
        <% if (currentUser) { %>
            <% if (currentUser.role==='admin' ) { %>
                <a href="/movies/new">Add Movie</a>
                <% } %>
                    <a href="/profile">Profile (<%= currentUser.name %>)</a>
                    <form action="/logout" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                    <% } else { %>
                        <a class="btn btn-outline-light btn-sm" style="scale: 1;" href="/login">Login</a>
                        <% } %>
    </nav>
</header>

<% if (messages.success) { %>
    <div class="alert alert-success" id="alert-success">
        <span>
            <%= messages.success %>
        </span>
        <button type="button" class="btn-close btn-close-white alert-close" aria-label="Close"
            onclick="closeAlert('alert-success')"></button>
    </div>
    <% } %>
        <% if (messages.error) { %>
            <div class="alert alert-error" id="alert-error">
                <span>
                    <%= messages.error %>
                </span>
                <button type="button" class="btn-close btn-close-white alert-close" aria-label="Close"
                    onclick="closeAlert('alert-error')"></button>
            </div>
            <% } %>

                <script>
                    function closeAlert(id) {
                        const el = document.getElementById(id);
                        if (el) {
                            el.style.opacity = '0';
                            setTimeout(() => el.remove(), 500);
                        }
                    }

                    document.addEventListener('DOMContentLoaded', () => {
                        ['alert-success', 'alert-error'].forEach(id => {
                            const el = document.getElementById(id);
                            if (el) {
                                setTimeout(() => closeAlert(id), 5000);
                            }
                        });
                    });
                </script>