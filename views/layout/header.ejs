<header>
    <h3>ReelTrack</h3>
    <nav>
        <a href="/movies">Movies</a>
        <a href="/reviews/movie/69a6c39ad34f76122d5eca20">Reviews</a>
        <% if (currentUser) { %>
            <a href="/movies/new">Add Movie</a>
            <a href="/profile">Profile (<%= currentUser.name %>)</a>
            <form action="/logout" method="POST" style="display: inline;">
                <button type="submit" class="btn">Logout</button>
            </form>
            <% } else { %>
            <a class="btn" href="/login">Login</a>
            <% } %>
    </nav>
</header>

<% if (messages.success) { %>
    <div class="alert alert-success" id="alert-success">
        <span>
            <%= messages.success %>
        </span>
        <button type="button" class="alert-close" onclick="closeAlert('alert-success')">&times;</button>
    </div>
    <% } %>
        <% if (messages.error) { %>
            <div class="alert alert-error" id="alert-error">
                <span>
                    <%= messages.error %>
                </span>
                <button type="button" class="alert-close" onclick="closeAlert('alert-error')">&times;</button>
            </div>
            <% } %>

                <script>
                    function closeAlert(id) {
                        const el = document.getElementById(id);
                        if (el) {
                            el.style.opacity = '0';
                            setTimeout(() => el.remove(), 500);
                        }
                    }

                    document.addEventListener('DOMContentLoaded', () => {
                        ['alert-success', 'alert-error'].forEach(id => {
                            const el = document.getElementById(id);
                            if (el) {
                                setTimeout(() => closeAlert(id), 5000);
                            }
                        });
                    });
                </script>