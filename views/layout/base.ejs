<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle + ' — ReelTrack' : 'ReelTrack — Track Every Frame' %>
    </title>
    <meta name="description"
        content="ReelTrack — your personal movie companion. Browse films, track your watchlist, write reviews, and join the discussion.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <%# Optional per-page CSS %>
        <% if (typeof extraCSS !=='undefined' ) { extraCSS.forEach(href=> { %>
            <link rel="stylesheet" href="<%= href %>">
            <% }) } %>
                <%# Optional per-page JS with defer %>
                    <% if (typeof extraJS !=='undefined' ) { extraJS.forEach(src=> { %>
                        <script defer src="<%= src %>"></script>
                        <% }) } %>
</head>

<body>