<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof pageTitle !=='undefined' ? pageTitle + ' - ReelTrack' : 'ReelTrack' %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <%# Optional per-page CSS: pass extraCSS as an array, e.g. { extraCSS: ['/css/movie.css'] } %>
        <% if (typeof extraCSS !=='undefined' ) { extraCSS.forEach(href=> { %>
            <link rel="stylesheet" href="<%= href %>">
            <% }) } %>
                <%# Optional per-page JS with defer: pass extraJS as an array, e.g. { extraJS: ['/js/movieEdit.js'] } %>
                    <% if (typeof extraJS !=='undefined' ) { extraJS.forEach(src=> { %>
                        <script defer src="<%= src %>"></script>
                        <% }) } %>
</head>

<body>