<%- include('../layout/base', { pageTitle: 'Add to Watchlist' }) %>
  <%- include('../layout/header') %>

    <div class="container-sm" style="padding-top: 2.5rem; padding-bottom: 4rem;">
      <div class="mb-md fade-in-up">
        <span class="section-label">Watchlist</span>
        <h1 style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px;">Add to Watchlist</h1>
        <p class="text-muted text-sm mt-sm">Track a movie you want to watch, are watching, or have watched.</p>
      </div>

      <div class="card fade-in-up" style="animation-delay: 0.1s; overflow: visible;">

        <% if (typeof error !== 'undefined' && error) { %>
          <div style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.875rem; margin-bottom: 1.5rem;">
            ⚠ <%= error %>
          </div>
          <% } %>

            <form action="/watchlist" method="POST" id="add-watchlist-form" style="overflow: visible;">
              <div class="form-group" style="position: relative; overflow: visible;">
                <label for="movieTitle">Movie Title</label>
                <input type="text" id="movieTitle" name="movieTitle" placeholder="Enter Movie Title" required>
                <input type="hidden" id="movieId" name="movieId">
                <div id="movie-suggestions" class="suggestions-dropdown"></div>
              </div>

              <div class="form-group">
                <label for="notes">Notes <span
                    style="font-weight: 400; color: var(--text-muted);">(optional)</span></label>
                <textarea id="notes" name="note" rows="3"
                  placeholder="Anything you want to remember about this film…"></textarea>
              </div>

              <div class="divider"></div>

              <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <a href="/watchlist" class="btn btn-ghost" id="cancel-watchlist">Cancel</a>
                <button type="submit" class="btn btn-primary" id="submit-watchlist">＋ Add to Watchlist</button>
              </div>
            </form>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const movieTitleInput = document.getElementById('movieTitle');
        const movieIdInput = document.getElementById('movieId');
        const suggestions = document.getElementById('movie-suggestions');

        document.getElementById('movieTitle').parentElement.style.position = 'relative';

        let debounceTimer;

        movieTitleInput.addEventListener('input', function () {
          clearTimeout(debounceTimer);
          const query = this.value.trim();
          movieIdInput.value = '';

          if (query.length < 2) { suggestions.innerHTML = ''; return; }

          debounceTimer = setTimeout(async () => {
            try {
              const res = await fetch(`/watchlist/search?q=${encodeURIComponent(query)}`);
              if (!res.ok) return;
              const movies = await res.json();
              suggestions.innerHTML = '';

              if (movies.length === 0) {
                suggestions.innerHTML = `<div style="padding:0.75rem 1rem; color:var(--text-muted); font-size:0.875rem;">No movies found</div>`;
                return;
              }

              movies.forEach(movie => {
                const item = document.createElement('div');
                item.className = 'suggestion-item';
                item.innerHTML = `
                  <div style="font-weight:700; font-size:0.95rem; color:var(--text);">${movie.title}</div>
                  <div style="font-size:0.78rem; color:var(--text-muted); margin-top:0.2rem; display:flex; gap:1rem;">
                    <span>📅 ${movie.releaseYear || 'N/A'}</span>
                    <span>🎬 ${movie.director || 'N/A'}</span>
                    <span>🎭 ${movie.genre || 'N/A'}</span>
                  </div>`;
                item.addEventListener('mouseenter', () => item.style.background = '#d3b1bf4a');
                item.addEventListener('mouseleave', () => item.style.background = '');
                item.addEventListener('click', () => {
                  movieTitleInput.value = movie.title;
                  movieIdInput.value = movie._id;
                  suggestions.innerHTML = '';
                });
                suggestions.appendChild(item);
              });
            } catch (err) {
              suggestions.innerHTML = `<div style="padding:0.75rem 1rem; color:#fca5a5; font-size:0.875rem;">Search failed</div>`;
            }
          }, 250);
        });

        document.addEventListener('click', (event) => {
          if (!movieTitleInput.contains(event.target) && !suggestions.contains(event.target)) {
            suggestions.innerHTML = '';
          }
        });

        document.getElementById('add-watchlist-form').addEventListener('submit', function(event) {
          if (!movieIdInput.value || movieIdInput.value.trim() === '') {
            event.preventDefault();
            movieTitleInput.setCustomValidity('Please select a movie from the dropdown suggestions.');
            movieTitleInput.reportValidity();
          } else {
            movieTitleInput.setCustomValidity('');
          }
        });

        document.getElementById('notes').addEventListener('keydown', function(event) {
          if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            document.getElementById('add-watchlist-form').requestSubmit();
          }
        });
      });
    </script>

    <%- include('../layout/footer') %>