<%- include('../layout/base', { pageTitle: 'Write a Review' }) %>
    <%- include('../layout/header') %>

        <div class="container-sm" style="padding-top: 2.5rem; padding-bottom: 4rem;">
            <div class="mb-md fade-in-up">
                <span class="section-label">Reviews</span>
                <h1 style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px;">Write a Review</h1>
                <p class="text-muted text-sm mt-sm">Share your honest thoughts about <strong
                        style="color: var(--text);">
                        <%= movie.title %>
                    </strong>.</p>
            </div>

            <div class="card fade-in-up" style="animation-delay: 0.1s;">
                <% if (error) { %>
                    <div
                        style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.875rem; margin-bottom: 1.5rem;">
                        ⚠ <%= error %>
                    </div>
                    <% } %>

                        <form action="/reviews/new/<%= movie._id %>" method="POST" id="new-review-form">
                            <div class="form-group">
                                <label for="rating">Your Rating</label>
                                <select name="rating" id="rating" required>
                                    <option value="" disabled <%=rating==='' ? 'selected' : '' %>>
                                        Select a rating…
                                    </option>
                                    <option value="5" <%=rating===5 ? 'selected' : '' %>>★★★★★ — Excellent (5)</option>
                                    <option value="4" <%=rating===4 ? 'selected' : '' %>>★★★★☆ — Good (4)</option>
                                    <option value="3" <%=rating===3 ? 'selected' : '' %>>★★★☆☆ — Average (3)</option>
                                    <option value="2" <%=rating===2 ? 'selected' : '' %>>★★☆☆☆ — Poor (2)</option>
                                    <option value="1" <%=rating===1 ? 'selected' : '' %>>★☆☆☆☆ — Terrible (1)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="reviewText">Your Review</label>
                                <textarea name="reviewText" id="reviewText" rows="6"
                                    placeholder="What did you think? What stood out? What fell flat?"
                                    required><%= reviewText %></textarea>
                            </div>

                            <div class="form-group" style="display: flex; align-items: center; gap: 0.6rem;">
                                <input type="checkbox" name="isAnonymous" id="isAnonymous" value="on">
                                <label for="isAnonymous"
                                    style="text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--text-muted); font-size: 0.875rem; margin: 0; cursor: pointer;">
                                    Post anonymously
                                </label>
                            </div>

                            <div class="divider"></div>

                            <div style="display: flex; gap: 1rem; align-items: center; justify-content: flex-end;">
                                <a href="/reviews/movie/<%= movie._id %>" class="btn btn-ghost"
                                    id="cancel-review">Cancel</a>
                                <button type="submit" class="btn btn-primary" id="submit-review">✍ Submit
                                    Review</button>
                            </div>
                        </form>
            </div>
        </div>

        <%- include('../layout/footer') %>