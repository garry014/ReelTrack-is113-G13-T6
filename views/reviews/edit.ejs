<%- include('../layout/base', { pageTitle: 'Edit Review — ' + review.movieId.title }) %>
    <%- include('../layout/header') %>

        <div class="container-sm" style="padding-top: 2.5rem; padding-bottom: 4rem;">
            <div class="mb-md fade-in-up">
                <span class="section-label">Reviews</span>
                <h1 style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px;">Edit Your Review</h1>
                <p class="text-muted text-sm mt-sm">Updating review for <strong style="color: var(--text);">
                        <%= review.movieId.title %>
                    </strong>.</p>
            </div>

            <div class="card fade-in-up" style="animation-delay: 0.1s;">
                <% if (error) { %>
                    <div
                        style="background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.875rem; margin-bottom: 1.5rem;">
                        ⚠ <%= error %>
                    </div>
                    <% } %>

                        <form action="/reviews/update/<%= review._id %>" method="POST" id="edit-review-form">
                            <input type="hidden" name="movieId" value="<%= review.movieId._id %>">

                            <div class="form-group">
                                <label for="rating">Your Rating</label>
                                <% const ratingScale=["Excellent", "Good" , "Average" , "Poor" , "Terrible" ] %>
                                    <% const selectedRating=typeof(rating) !=='undefined' ? parseInt(rating) :
                                        review.rating %>
                                        <select name="rating" id="rating" required>
                                            <% for (let i=5; i>= 1; i--) { %>
                                                <option value="<%= i %>" <%=selectedRating===i ? 'selected' : '' %>>
                                                    <%= '★' .repeat(i) + '☆' .repeat(5 - i) %> -
                                                        <%= ratingScale[5 - i] %> (<%= i %>)
                                                </option>
                                                <% } %>
                                        </select>

                            </div>

                            <div class="form-group">
                                <label for="reviewText">Your Review</label>
                                <textarea name="reviewText" id="reviewText" rows="6"
                                    required><%= typeof(reviewText) !=='undefined' ? reviewText : review.reviewText %></textarea>
                            </div>

                            <div class="form-group" style="display: flex; align-items: center; gap: 0.6rem;">
                                <% const selectedIsAnonymous=typeof(isAnonymousBool) !=='undefined' ?
                                    parseInt(isAnonymousBool) : review.isAnonymous %>
                                    <input type="checkbox" name="isAnonymous" id="isAnonymous" value="on"
                                        <%=selectedIsAnonymous ? 'checked' : '' %>>
                                    <label for="isAnonymous"
                                        style="text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--text-muted); font-size: 0.875rem; margin: 0; cursor: pointer;">
                                        Post anonymously
                                    </label>
                            </div>

                            <div class="divider"></div>

                            <div style="display: flex; gap: 1rem; align-items: center; justify-content: flex-end;">
                                <a href="/reviews/movie/<%= review.movieId._id %>" class="btn btn-ghost"
                                    id="cancel-edit-review">Cancel</a>
                                <button type="submit" class="btn btn-warning" id="update-review">✎ Update
                                    Review</button>
                            </div>
                        </form>
            </div>
        </div>

        <%- include('../layout/footer') %>