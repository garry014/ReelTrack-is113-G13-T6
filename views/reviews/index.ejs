<%- include('../layout/base', { pageTitle: 'Reviews' , extraCSS: ['/css/review.css'] }) %>
    <%- include('../layout/header') %>

        <div class="container">
            <!-- Movie Header Info -->
            <div class="movie-header">
                <h1>Reviews</h1>

                <div class="overall-rating">
                    <% if(averageRating.totalReviews> 0) { %>
                        Average Rating:
                        <span class="stars">★ <%= averageRating.averageRating %> / 5</span>
                        <br>
                        <i style="font-size: 14px;">based on <%= averageRating.totalReviews %> review(s)</i>
                        <% } else { %>
                            <p>No reviews yet</p>
                            <% } %>
                </div>

                <% if (currentUser && !hasReviewed) { %>
                    <a href="/reviews/new/<%= MOVIE_ID %>" class="btn btn-primary">Write a Review</a>
                    <% } else if (currentUser && hasReviewed) { %>
                        <p style="color: var(--text-light);"><i>You have already reviewed this movie.</i></p>
                        <% } else { %>
                            <p><a href="/login" style="color: var(--primary-color);">Log in</a> to write a review.</p>
                            <% } %>
            </div>

            <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border-color);">

            <!-- Reviews List -->
            <div class="reviews-list">
                <% if (reviews.length===0) { %>
                    <div class="card" style="text-align: center; padding: 3rem;">
                        <h3>No reviews yet</h3>
                        <p style="color: var(--text-light); margin-top: 0.5rem;">Be the first to review this movie!</p>
                    </div>
                    <% } else { %>
                        <% reviews.forEach(review=> { %>
                            <div class="card review-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <strong>
                                            <% if(review.isAnonymous) { %>
                                                Anonymous
                                                <% } else { %>
                                                    <%= review.owner.name %>
                                                        <% } %>
                                        </strong>
                                        <span class="review-date">
                                            <%= new Date(review.createdAt).toLocaleDateString() %>
                                                <% if (review.edited) { %>
                                                    <small class="text-muted">(Edited)</small>
                                                    <% } %>
                                        </span>
                                    </div>
                                    <div class="review-rating">★ <%= review.rating %> / 5</div>
                                </div>

                                <div class="review-body">
                                    <p>
                                        <%= review.reviewText %>
                                    </p>
                                </div>

                                <!-- Review Actions (Edit/Delete) if the review is written by the logged-in user -->
                                <% if (currentUser && currentUser._id.toString()===review.owner._id.toString()) { %>
                                    <div class="review-actions">
                                        <a href="/reviews/<%= review._id %>" class="btn btn-secondary btn-sm">Edit</a>
                                        <form action="/reviews/<%= review._id %>?_method=DELETE" method="POST"
                                            style="display:inline;">
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this review?')">Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>
                            <% }) %>
                                <% } %>
            </div>

            <!-- Pagination Controls -->
            <% if (totalPages> 1) { %>
                <nav class="pagination">
                    <% if (currentPage> 1) { %>
                        <a href="/reviews/movie/<%= MOVIE_ID %>?page=<%= currentPage - 1 %>&limit=<%= limit %>">&laquo;
                            Prev</a>
                        <% } else { %>
                            <span class="disabled">&laquo; Prev</span>
                            <% } %>

                                <% for (let i=1; i <=totalPages; i++) { %>
                                    <% if (i===currentPage) { %>
                                        <span class="active">
                                            <%= i %>
                                        </span>
                                        <% } else { %>
                                            <a href="/reviews/movie/<%= MOVIE_ID %>?page=<%= i %>&limit=<%= limit %>">
                                                <%= i %>
                                            </a>
                                            <% } %>
                                                <% } %>

                                                    <% if (currentPage < totalPages) { %>
                                                        <a
                                                            href="/reviews/movie/<%= MOVIE_ID %>?page=<%= currentPage + 1 %>&limit=<%= limit %>">Next
                                                            &raquo;</a>
                                                        <% } else { %>
                                                            <span class="disabled">Next &raquo;</span>
                                                            <% } %>
                </nav>
                <% } %>
        </div>

        <%- include('../layout/footer') %>