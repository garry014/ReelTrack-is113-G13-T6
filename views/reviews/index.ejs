<%- include('../layout/base', { pageTitle: 'Reviews — ' + MOVIE.title, extraCSS: ['/css/review.css'] }) %>
    <%- include('../layout/header') %>

        <div class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">

            <!-- Movie Details Banner -->
            <div class="movie-banner fade-in-up"
                style="display: flex; gap: 2rem; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem; margin-bottom: 2rem;">
                <% if (MOVIE.posterUrl) { %>
                    <img src="<%= MOVIE.posterUrl %>" alt="<%= MOVIE.title %> poster"
                        style="width: 110px; height: 160px; object-fit: cover; border-radius: 10px; flex-shrink: 0; box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                    <% } else { %>
                        <div
                            style="width: 110px; height: 160px; border-radius: 10px; flex-shrink: 0; background: var(--surface-2); display: flex; align-items: center; justify-content: center; font-size: 2.5rem;">
                            🎬</div>
                        <% } %>
                            <div style="flex: 1; min-width: 0;">
                                <span class="section-label">Now Reviewing</span>
                                <h1
                                    style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.5px; margin-top: 0.25rem; margin-bottom: 0.5rem;">
                                    <%= MOVIE.title %>
                                </h1>
                                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                                    <span
                                        style="background: rgba(var(--primary-rgb, 99,102,241),0.15); color: var(--primary); padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600;">
                                        <%= MOVIE.genre %>
                                    </span>
                                    <span
                                        style="background: var(--surface-2); color: var(--text-muted); padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem;">📅
                                        <%= MOVIE.releaseYear %>
                                    </span>
                                    <span
                                        style="background: var(--surface-2); color: var(--text-muted); padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem;">🎬
                                        <%= MOVIE.director %>
                                    </span>
                                    <span
                                        style="background: var(--surface-2); color: var(--text-muted); padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem;">⏱
                                        <%= MOVIE.duration %> min
                                    </span>
                                </div>
                                <p
                                    style="color: var(--text-muted); font-size: 0.875rem; line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    <%= MOVIE.synopsis %>
                                </p>
                            </div>
            </div>

            <!-- Header -->
            <div class="reviews-header">
                <div>
                    <span class="section-label">Movie Reviews</span>
                    <h2 style="font-size: 1.5rem; font-weight: 800;">Community Reviews</h2>
                    <% if (currentUser && !hasReviewed) { %>
                        <a href="/reviews/new/<%= MOVIE_ID %>" class="btn btn-primary mt-sm" id="write-review-btn">✍
                            Write a Review</a>
                        <% } else if (currentUser && hasReviewed) { %>
                            <p class="review-cta-notice mt-sm">✓ You've already reviewed this movie.</p>
                            <% } else { %>
                                <p class="text-muted text-sm mt-sm"><a href="/login">Log in</a> to write a review.</p>
                                <% } %>
                </div>

                <% if (averageRating.totalReviews> 0) { %>
                    <div class="overall-rating-box">
                        <div class="stars-big">★</div>
                        <div class="rating-number">
                            <%= averageRating.averageRating %><span
                                    style="font-size: 1rem; font-weight: 500; color: var(--text-muted);"> / 5</span>
                        </div>
                        <div class="rating-count">Based on <%= averageRating.totalReviews %> review<%=
                                    averageRating.totalReviews> 1 ? 's' : '' %></div>
                    </div>
                    <% } else { %>
                        <div class="overall-rating-box">
                            <div class="stars-big" style="opacity: 0.3;">★</div>
                            <div class="rating-count" style="margin-top: 0.5rem;">No ratings yet</div>
                        </div>
                        <% } %>
            </div>

            <div class="divider"></div>

            <!-- Reviews List -->
            <div class="reviews-list">
                <% if (reviews.length===0) { %>
                    <div class="empty-state">
                        <div class="empty-icon">💬</div>
                        <h3>No reviews yet</h3>
                        <p>Be the first to share your thoughts about this film!</p>
                        <% if (currentUser && !hasReviewed) { %>
                            <a href="/reviews/new/<%= MOVIE_ID %>" class="btn btn-primary" id="write-first-review">Write
                                the first review</a>
                            <% } %>
                    </div>
                    <% } else { %>
                        <% reviews.forEach(review=> { %>
                            <div class="review-card">
                                <div class="review-header">
                                    <div class="reviewer-info">
                                        <div class="reviewer-avatar">
                                            <% if (review.isAnonymous) { %>?<% } else { %>
                                                    <%= review.owner.name.charAt(0).toUpperCase() %>
                                                        <% } %>
                                        </div>
                                        <div>
                                            <strong>
                                                <% if (review.isAnonymous) { %>Anonymous<% } else { %>
                                                        <%= review.owner.name %>
                                                            <% } %>
                                            </strong>
                                            <span class="review-date">
                                                <%= new Date(review.createdAt).toLocaleDateString('en-US', {
                                                    year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                                    <% if (review.edited) { %><small class="text-muted"> ·
                                                            Edited</small>
                                                        <% } %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="review-rating-badge">★ <%= review.rating %> / 5</div>
                                </div>

                                <div class="review-body">
                                    <p>
                                        <%= review.reviewText %>
                                    </p>
                                </div>

                                <% if (currentUser && currentUser._id.toString()===review.owner._id.toString()) { %>
                                    <div class="review-actions">
                                        <a href="/reviews/<%= review._id %>" class="btn btn-ghost btn-sm"
                                            id="edit-review-<%= review._id %>">✎ Edit</a>
                                        <form action="/reviews/delete/<%= review._id %>" method="POST"
                                            style="display:inline;">
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('Delete this review? This cannot be undone.')"
                                                id="delete-review-<%= review._id %>">✕ Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>
                            <% }) %>
                                <% } %>
            </div>

            <!-- Pagination -->
            <% if (totalPages> 1) { %>
                <nav class="pagination" aria-label="Reviews pagination">
                    <% if (currentPage> 1) { %>
                        <a href="/reviews/movie/<%= MOVIE_ID %>?page=<%= currentPage - 1 %>&limit=<%= limit %>">‹
                            Prev</a>
                        <% } else { %>
                            <span class="disabled">‹ Prev</span>
                            <% } %>

                                <% for (let i=1; i <=totalPages; i++) { %>
                                    <% if (i===currentPage) { %>
                                        <span class="active">
                                            <%= i %>
                                        </span>
                                        <% } else { %>
                                            <a href="/reviews/movie/<%= MOVIE_ID %>?page=<%= i %>&limit=<%= limit %>">
                                                <%= i %>
                                            </a>
                                            <% } %>
                                                <% } %>

                                                    <% if (currentPage < totalPages) { %>
                                                        <a
                                                            href="/reviews/movie/<%= MOVIE_ID %>?page=<%= currentPage + 1 %>&limit=<%= limit %>">Next
                                                            ›</a>
                                                        <% } else { %>
                                                            <span class="disabled">Next ›</span>
                                                            <% } %>
                </nav>
                <% } %>
        </div>

        <%- include('../layout/footer') %>