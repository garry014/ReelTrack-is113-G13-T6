<%- include('../layout/base', { pageTitle: 'My Profile' }) %>
<%- include('../layout/header') %>

<div class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">



    <!-- ── PROFILE CARD ── -->
    <div class="card fade-in-up" style="max-width: 560px; margin: 0 auto 2.5rem;">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <div style="
                width: 60px; height: 60px; border-radius: 50%;
                background: linear-gradient(135deg, var(--primary), #7c3aed);
                display: flex; align-items: center; justify-content: center;
                font-size: 1.5rem; font-weight: 800; color: white; flex-shrink: 0;">
                <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <div>
                <span class="section-label" style="margin-bottom: 0.1rem;">Profile</span>
                <h1 style="font-size: 1.5rem; font-weight: 800; letter-spacing: -0.3px; margin-bottom: 0;">
                    <%= user.name %>
                </h1>
                <p class="text-muted text-sm"><%= user.email %></p>
            </div>
        </div>
        <div class="divider"></div>
        <p class="text-muted text-sm">Member since <strong style="color: var(--text)">
            <%= user.createdAt.toDateString() %>
        </strong></p>
        <p class="text-muted text-sm" style="margin-top: 0.4rem;">
            Role: <strong style="color: var(--text); text-transform: capitalize;"><%= user.role %></strong>
        </p>
    </div>

    <!-- ── ITEMS ── -->
    <% if (typeof items !== 'undefined' && items.length > 0) { %>
        <div class="fade-in-up" style="animation-delay: 0.1s; max-width: 560px; margin: 0 auto 2.5rem;">
            <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 1rem;">My Items</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
                <% items.forEach(item => { %>
                    <div class="card" style="padding: 1.25rem;">
                        <span class="badge badge-blue mb-sm"><%= item.category %></span>
                        <h3 style="font-size: 1rem; margin-bottom: 0.3rem;"><%= item.title %></h3>
                        <p class="text-gold" style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem;">
                            $<%= item.price %>
                        </p>
                        <a href="/items/<%= item._id %>" class="btn btn-ghost btn-sm">View Item →</a>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

    <!-- ── UPDATE PROFILE FORM ── -->
    <div class="card fade-in-up" style="max-width: 560px; margin: 2rem auto 0; animation-delay: 0.15s;">

        <div style="margin-bottom: 1.25rem;">
            <span class="section-label">Edit Profile</span>
            <h2 style="font-size: 1.2rem; font-weight: 800; letter-spacing: -0.3px; margin-top: 0.2rem;">
                Update Your Details
            </h2>
            <p class="text-muted text-sm" style="margin-top: 0.3rem;">
                Enter your current password to confirm any changes.
            </p>
        </div>

        <!-- ✅ Fixed: was /profile/edit, must be /user/profile/edit to match server.js mount -->
        <form action="/user/profile/edit" method="POST" id="edit-profile-form">

            <div class="form-group">
                <label for="edit-name">Full Name</label>
                <input
                    type="text"
                    id="edit-name"
                    name="name"
                    value="<%= user.name %>"
                    placeholder="Your full name"
                    required>
            </div>

            <div class="form-group">
                <label for="edit-email">Email Address</label>
                <input
                    type="email"
                    id="edit-email"
                    name="email"
                    value="<%= user.email %>"
                    placeholder="you@example.com"
                    required>
            </div>

            <div class="divider"></div>

            <p class="text-muted text-sm" style="margin-bottom: 1rem;">
                🔒 Leave the <strong style="color:var(--text)">New Password</strong> fields blank if you don't want to change it.
            </p>

            <div class="form-group">
                <label for="edit-newPassword">New Password <span class="text-muted">(optional)</span></label>
                <input
                    type="password"
                    id="edit-newPassword"
                    name="newPassword"
                    placeholder="Min. 8 characters">
            </div>

            <div class="form-group">
                <label for="edit-confirmPassword">Confirm New Password</label>
                <input
                    type="password"
                    id="edit-confirmPassword"
                    name="confirmPassword"
                    placeholder="Repeat new password">
            </div>

            <div class="divider"></div>

            <div class="form-group">
                <label for="edit-currentPassword">
                    Current Password <span style="color: var(--primary);">*</span>
                </label>
                <input
                    type="password"
                    id="edit-currentPassword"
                    name="currentPassword"
                    placeholder="Required to save changes"
                    required>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                Save Changes →
            </button>

        </form>
    </div>

    <!-- ── DELETE ACCOUNT SECTION ── -->
    <div class="card fade-in-up" style="
        max-width: 560px;
        margin: 2rem auto 0;
        animation-delay: 0.2s;
        border-color: rgba(229,9,20,0.25);
        background: rgba(229,9,20,0.04);">

        <div style="margin-bottom: 1.25rem;">
            <span class="section-label" style="color: #f87171;">Danger Zone</span>
            <h2 style="font-size: 1.2rem; font-weight: 800; letter-spacing: -0.3px; margin-top: 0.2rem;">
                Delete Account
            </h2>
            <p class="text-muted text-sm" style="margin-top: 0.3rem;">
                ⚠️ This is <strong style="color: #f87171;">permanent and irreversible.</strong>
                All your data will be deleted. Confirm your password to proceed.
            </p>
        </div>

        <button
            type="button"
            id="delete-toggle-btn"
            class="btn btn-ghost btn-sm"
            style="border-color: rgba(229,9,20,0.4); color: #f87171; margin-bottom: 1rem;"
            onclick="document.getElementById('delete-form-wrap').style.display =
                     document.getElementById('delete-form-wrap').style.display === 'none' ? 'block' : 'none'">
            🗑️ I want to delete my account
        </button>

        <div id="delete-form-wrap" style="display: none;">
            <!-- ✅ Fixed: was /profile/delete, must be /user/profile/delete to match server.js mount -->
            <form action="/user/profile/delete" method="POST" id="delete-account-form">
                <div class="form-group">
                    <label for="delete-confirmPassword">Confirm Your Password</label>
                    <input
                        type="password"
                        id="delete-confirmPassword"
                        name="confirmPassword"
                        placeholder="Enter your password to confirm"
                        required>
                </div>
                <button
                    type="submit"
                    class="btn btn-block"
                    style="
                        background: rgba(229,9,20,0.15);
                        color: #f87171;
                        border: 1px solid rgba(229,9,20,0.4);
                        font-weight: 700;"
                    onclick="return confirm('Are you absolutely sure? This cannot be undone.')">
                    ⚠️ Permanently Delete My Account
                </button>
            </form>
        </div>
    </div>

</div>

<%- include('../layout/footer') %>
