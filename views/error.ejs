<%- include('./layout/base', { pageTitle: 'Error' }) %>
    <%- include('./layout/header') %>

        <div class="container-sm" style="padding-top: 4rem; padding-bottom: 4rem; text-align: center;">
            <div class="fade-in-up">
                <div style="font-size: 4rem; margin-bottom: 1.5rem; opacity: 0.4;">⚠</div>
                <span class="section-label">Error</span>
                <h1 style="font-size: 2rem; font-weight: 900; letter-spacing: -0.5px; margin-bottom: 1rem;">Something
                    went wrong</h1>

                <div
                    style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin: 0 auto 2rem; max-width: 480px; text-align: left;">
                    <p style="color: #fca5a5; font-size: 0.9rem;">
                        <%= message %>
                    </p>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                    <a href="javascript:history.back()" class="btn btn-ghost" id="go-back">← Go Back</a>
                    <a href="/movies" class="btn btn-primary" id="go-home">Go to Movies</a>
                </div>
            </div>
        </div>

        <%- include('./layout/footer') %>