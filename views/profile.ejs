<%- include('./layout/base', { pageTitle: 'My Profile' }) %>
    <%- include('./layout/header') %>

        <div class="container">
            <div class="card">
                <h1>My Profile</h1>
                <p><strong>Name:</strong>
                    <%= user.name %>
                </p>
                <p><strong>Email:</strong>
                    <%= user.email %>
                </p>
                <p><strong>Joined:</strong>
                    <%= user.createdAt.toDateString() %>
                </p>
            </div>

            <h2>My Items</h2>
            <div class="item-grid">
                <% items.forEach(item=> { %>
                    <div class="card item-card">
                        <span class="badge">
                            <%= item.category %>
                        </span>
                        <h3>
                            <%= item.title %>
                        </h3>
                        <p class="price">$<%= item.price %>
                        </p>
                        <a href="/items/<%= item._id %>">View Item</a>
                    </div>
                    <% }) %>
            </div>
        </div>

        <%- include('./layout/footer') %>