<%- include('../layout/base', { pageTitle: 'All Movies' }) %>
    <%- include('../layout/header') %>

        <section class="movies">
            <h2>All Movies</h2>
            <hr style="border-color: #ff2424;">
            <div class="movies-container">
                <% allMovies.forEach((movie)=> { %>
                    <a href="/movies/<%= movie._id %>" class="movie-card">
                        <img src=<%=movie.posterUrl %> />
                        <p>
                            <%= movie.title %>
                        </p>
                        <span>
                            <%=movie.duration %> mins
                        </span>
                    </a>
                    <% }) %>
            </div>
        </section>

        <%- include('../layout/footer') %>