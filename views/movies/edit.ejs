<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= movie.title %> - ReelTrack</title>
    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/movieEdit.js"></script>
</head>

<body>
    <%- include('../layout/header') %>
        <div class="container">
            <div class="card" style="max-width: 600px; margin: 0 auto;">
                <h1>Edit Movie</h1>
                <form id="editMovieForm">
                    <input type="hidden" id="movieid" value="<%=movie._id %>">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" name="title" value="<%= movie.title %>" required>
                    </div>
                    <div class="form-group">
                        <label for="director">Director</label>
                        <input type="text" id="director" name="director" value="<%= movie.director %>" required>
                    </div>
                    <div class="form-group">
                        <label for="year">Release Year</label>
                        <input type="number" id="year" name="year" value="<%= movie.releaseYear %>" required>
                    </div>
                    <div class="form-group">
                        <label for="poster">Poster URL</label>
                        <input type="url" id="poster" name="poster" value="<%= movie.posterUrl %>" required>
                    </div>
                    <div class="form-group">
                        <label for="duration">Duration in mins (3 digits)</label>
                        <input type="number" id="duration" name="duration" value="<%= movie.duration %>" required>
                    </div>
                    <div class="form-group">
                        <label for="genre">Genre</label>
                        <select id="genre" name="genre" required>
                            <option value="Action" <%=movie.genre==='Action' ? 'selected' : '' %>
                                >Action</option>
                            <option value="Sci-Fi" <%=movie.genre==='Sci-Fi' ? 'selected' : '' %>>Sci-Fi
                            </option>
                            <option value="Fantasy" <%=movie.genre==='Fantasy' ? 'selected' : '' %>>Fantasy
                            </option>
                            <option value="Thriller" <%=movie.genre==='Thriller' ? 'selected' : '' %>>Thriller</option>
                            <option value="Tragedy" <%=movie.genre==='Tragedy' ? 'selected' : '' %>>Tragedy</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="synopsis">Synopsis</label>
                        <textarea id="synopsis" name="synopsis" rows="5"
                            required><%= movie.synopsis %></textarea>
                    </div>
                    <button type="submit">Update movie</button>
                </form>
            </div>
        </div>
</body>

</html>