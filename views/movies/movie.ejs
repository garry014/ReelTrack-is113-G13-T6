<%- include('../layout/base', { pageTitle: movie.title, extraCSS: ['/css/movie.css'] }) %>
    <%- include('../layout/header') %>

        <h2>
            <%= movie.title %>
        </h2>
        <section class="details">
            <img src=<%=movie.posterUrl %>>
            <div>
                <p>Director:</p><span>
                    <%= movie.director %>
                </span>
                <p>Genre:</p><span>
                    <%= movie.genre %>
                </span>
                <p>Duration:</p><span>
                    <%= movie.duration %> minutes
                </span>
                <p>Release Year:</p><span>
                    <%= movie.releaseYear %>
                </span>
            </div>
            <div style="display: flex;flex-direction: column;row-gap: 1rem;">
                <% if(currentUser){ %>
                    <a class="btn btn-warning" href="/movies/<%= movie._id %>/edit">Edit Movie</a>
                    <button id="delete" class="btn btn-danger" data-movieid="<%= movie._id %>">Delete Movie</button>
                    <a class="btn btn-primary" href="/watchlist/new">Add to Watchlist</a>
                    <% } %>
            </div>
        </section>

        <div class="links">
            <a href="/reviews/movie/<%= movie._id %>">Reviews</a><a href="">Comments</a>
        </div>

        <section class="story">
            <p>Synopsis</p>
            <p>
                <%= movie.synopsis %>
            </p>
        </section>

        <script>
            let deletebtn = document.getElementById('delete')
            deletebtn.addEventListener('click', (event) => {
                if (confirm('Are you sure you want to delete? (This is a irreversible action)')) {
                    fetch(`/movies/${deletebtn.dataset.movieid}`, { method: 'DELETE' })
                        .then(response => response.json())
                        .then(data => {
                            alert(data.message);
                            location.href = data.redirect
                        })
                        .catch(error => alert(error.message))
                }
            })
        </script>

        <%- include('../layout/footer') %>