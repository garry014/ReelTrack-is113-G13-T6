<%- include('../layout/base', { pageTitle: movie.title, extraCSS: ['/css/movie.css'] }) %>
    <%- include('../layout/header') %>

        <div class="container">
            <!-- Movie Hero -->
            <div class="movie-detail-hero">
                <div class="movie-poster-wrap">
                    <img src="<%= movie.posterUrl %>" alt="<%= movie.title %> poster">
                </div>

                <div class="movie-meta-block">
                    <span class="section-label">
                        <%= movie.genre %>
                    </span>
                    <h1 class="movie-title-main">
                        <%= movie.title %>
                    </h1>

                    <div class="movie-info-grid">
                        <a href="/reviews/movie/<%= movie._id %>"
                            style="display: contents; text-decoration: none; color: inherit; cursor: pointer;">
                            <div class="movie-info-item" style="cursor: pointer;">
                                <span class="movie-info-label">Ratings</span>
                                <span class="movie-info-value">
                                    <% if (ratingData.totalReviews> 0) { %>
                                        ★ <%= ratingData.averageRating %> / 5
                                            <div
                                                style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.2rem;">
                                                Based on <%= ratingData.totalReviews %> reviews
                                            </div>
                                            <% } else { %>
                                                No reviews yet
                                                <% } %>
                                </span>
                            </div>
                        </a>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Director</span>
                            <span class="movie-info-value">
                                <%= movie.director %>
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Year</span>
                            <span class="movie-info-value">
                                <%= movie.releaseYear %>
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Duration</span>
                            <span class="movie-info-value">
                                <%= movie.duration %> mins
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Genre</span>
                            <span class="movie-info-value">
                                <%= movie.genre %>
                            </span>
                        </div>
                    </div>

                    <% if (currentUser && currentUser.role==='admin' ) { %>
                        <div class="movie-admin-actions">
                            <a class="btn btn-warning" href="/movies/<%= movie._id %>/edit" id="edit-movie">✎ Edit
                                Movie</a>
                            <button id="delete-movie" class="btn btn-danger" data-movieid="<%= movie._id %>">✕ Delete
                                Movie</button>
                            <form action="/watchlist" method="POST" style="display: inline;">
                                <input type="hidden" name="movieId" value="<%= movie._id %>">
                                <input type="hidden" name="movieTitle" value="<%= movie.title %>">
                                <button type="submit" class="btn btn-primary">➕ Add to Watchlist</button>
                            </form>
                        </div>
                        <% } else if (currentUser) { %>
                            <div class="watchlist-status-display">
                                <span class="status-badge" data-movieid="<%= movie._id %>"
                                    data-movietitle="<%= movie.title %>">
                                    Checking status...
                                </span>
                            </div>
                            <%} else if (currentUser) {%>
                                <a href="/login" class="btn btn-primary">➕ Add to Watchlist</a>
                                <% } %>

                                    <div id="watchlist-modal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
                      background: rgba(0,0,0,0.6); z-index: 10000; backdrop-filter: blur(4px);">
                                        <div class="modal-box" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); 
                        background: #12121a; border-radius: 16px; padding: 2rem; max-width: 480px; width: 90%; max-height: 85vh; 
                        overflow-y: auto; box-shadow: 0 25px 50px rgba(0,0,0,0.25);">
                                            <div
                                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                                                <h3 style="margin: 0; font-size: 1.3rem; font-weight: 700;">Add <span
                                                        id="modal-movie-title" style="color: var(--primary);"></span> to
                                                    Watchlist</h3>
                                                <button onclick="closeWatchlistModal()"
                                                    style="background: none; border: none; font-size: 1.8rem; cursor: pointer; color: var(--text-muted);">&times;</button>
                                            </div>

                                            <form action="/watchlist" method="POST" id="quick-watchlist-form">
                                                <input type="hidden" name="movieId" id="modal-movie-id">
                                                <div class="form-group" style="margin-bottom: 1.5rem;">
                                                    <label
                                                        style="display: block; margin-bottom: 0.5rem; font-weight: 600;">Quick
                                                        note (optional)</label>
                                                    <textarea name="note" rows="4"
                                                        placeholder="Anything you want to remember about this film..."
                                                        style="width: 100%; padding: 0.75rem; border: 2px solid var(--border); 
                                border-radius: 8px; resize: vertical; font-family: inherit;"
                                                        maxlength="500"></textarea>
                                                </div>
                                                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                                                    <button type="button" class="btn btn-ghost"
                                                        onclick="closeWatchlistModal()">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">➕ Add to
                                                        Watchlist</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <script>
                                        document.addEventListener('DOMContentLoaded', async function () {
                                            const isLoggedIn = '<%= currentUser ? "true" : "false" %>' === 'true';
                                            const statusBadge = document.querySelector('.status-badge');

                                            if (!statusBadge || !isLoggedIn) {
                                                if (statusBadge) statusBadge.innerHTML = '➕ Add to Watchlist';
                                                return;
                                            }

                                            const movieId = statusBadge.dataset.movieid;
                                            const movieTitle = statusBadge.dataset.movietitle;

                                            try {
                                                const response = await fetch(`/watchlist/check?movieId=${movieId}`);
                                                const data = await response.json();

                                                if (data.inWatchlist) {
                                                    statusBadge.innerHTML = '🎬 In Watchlist';
                                                    statusBadge.className = 'status-badge in-watchlist';
                                                    statusBadge.style.cursor = 'default';
                                                } else {
                                                    statusBadge.innerHTML = '➕ Add to Watchlist';
                                                    statusBadge.className = 'status-badge add-watchlist btn btn-primary';
                                                    statusBadge.style.cursor = 'pointer';
                                                    statusBadge.onclick = () => openWatchlistModal(movieId, movieTitle);
                                                }
                                            } catch (error) {
                                                console.error('Watchlist check failed:', error);
                                                statusBadge.innerHTML = '➕ Add to Watchlist';
                                                statusBadge.className = 'status-badge add-watchlist btn btn-primary';
                                                statusBadge.onclick = () => openWatchlistModal(movieId, movieTitle);
                                            }
                                        });

                                        document.querySelector('textarea[name="note"]').addEventListener('keydown', function (event) {
                                            if (event.key === 'Enter' && !event.shiftKey) {
                                                event.preventDefault();
                                                document.getElementById('quick-watchlist-form').submit();
                                            }
                                        });

                                        function openWatchlistModal(movieId, movieTitle) {
                                            document.getElementById('modal-movie-id').value = movieId;
                                            document.getElementById('modal-movie-title').textContent = movieTitle;
                                            document.getElementById('watchlist-modal').style.display = 'block';
                                            document.querySelector('textarea[name="note"]').focus();
                                        }

                                        function closeWatchlistModal() {
                                            document.getElementById('watchlist-modal').style.display = 'none';
                                            document.getElementById('quick-watchlist-form').reset();
                                        }

                                        document.addEventListener('click', function (event) {
                                            const modal = document.getElementById('watchlist-modal');
                                            if (event.target === modal) closeWatchlistModal();
                                        });

                                    </script>


                                    <!-- Tab Links -->
                                    <div class="movie-tabs">
                                        <a href="/reviews/movie/<%= movie._id %>" class="movie-tab-link">⭐ Reviews</a>
                                        <a href="/comments/movie/<%=movie._id%>" class="movie-tab-link">💬
                                            Discussion</a>
                                    </div>

                                    <!-- Synopsis -->
                                    <div class="movie-synopsis">
                                        <p class="movie-synopsis-title">Synopsis</p>
                                        <p>
                                            <%= movie.synopsis %>
                                        </p>
                                    </div>
                </div>

                <script>
                    const deletebtn = document.getElementById('delete-movie');
                    if (deletebtn) {
                        deletebtn.addEventListener('click', () => {
                            if (confirm('Are you sure you want to delete this movie? This cannot be undone.')) {
                                fetch(`/movies/${deletebtn.dataset.movieid}`, { method: 'DELETE' })
                                    .then(r => r.json())
                                    .then(data => {
                                        alert(data.message);
                                        location.href = data.redirect;
                                    })
                                    .catch(err => alert(err.message));
                            }
                        });
                    }
                </script>

                <%- include('../layout/footer') %>