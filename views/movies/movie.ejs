<%- include('../layout/base', { pageTitle: movie.title, extraCSS: ['/css/movie.css'] }) %>
    <%- include('../layout/header') %>

        <div class="container">
            <!-- Movie Hero -->
            <div class="movie-detail-hero">
                <div class="movie-poster-wrap">
                    <img src="<%= movie.posterUrl %>" alt="<%= movie.title %> poster">
                </div>

                <div class="movie-meta-block">
                    <span class="section-label">
                        <%= movie.genre %>
                    </span>
                    <h1 class="movie-title-main">
                        <%= movie.title %>
                    </h1>

                    <div class="movie-info-grid">
                        <div class="movie-info-item">
                            <span class="movie-info-label">Director</span>
                            <span class="movie-info-value">
                                <%= movie.director %>
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Year</span>
                            <span class="movie-info-value">
                                <%= movie.releaseYear %>
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Duration</span>
                            <span class="movie-info-value">
                                <%= movie.duration %> mins
                            </span>
                        </div>
                        <div class="movie-info-item">
                            <span class="movie-info-label">Genre</span>
                            <span class="movie-info-value">
                                <%= movie.genre %>
                            </span>
                        </div>
                    </div>

                    <% if (currentUser && currentUser.role==='admin' ) { %>
                        <div class="movie-admin-actions">
                            <a class="btn btn-warning" href="/movies/<%= movie._id %>/edit" id="edit-movie">✎ Edit
                                Movie</a>
                            <button id="delete-movie" class="btn btn-danger" data-movieid="<%= movie._id %>">✕ Delete
                                Movie</button>
                            <a class="btn btn-ghost" href="/watchlist/new" id="add-watchlist">＋ Add to Watchlist</a>
                        </div>
                        <% } else if (currentUser) { %>
                            <div class="movie-admin-actions">
                                <a class="btn btn-ghost" href="/watchlist/new" id="add-watchlist">＋ Add to Watchlist</a>
                            </div>
                            <% } %>
                </div>
            </div>

            <!-- Tab Links -->
            <div class="movie-tabs">
                <a href="/reviews/movie/<%= movie._id %>" class="movie-tab-link">⭐ Reviews</a>
                <a href="#" class="movie-tab-link">💬 Discussion</a>
            </div>

            <!-- Synopsis -->
            <div class="movie-synopsis">
                <p class="movie-synopsis-title">Synopsis</p>
                <p>
                    <%= movie.synopsis %>
                </p>
            </div>
        </div>

        <script>
            const deletebtn = document.getElementById('delete-movie');
            if (deletebtn) {
                deletebtn.addEventListener('click', () => {
                    if (confirm('Are you sure you want to delete this movie? This cannot be undone.')) {
                        fetch(`/movies/${deletebtn.dataset.movieid}`, { method: 'DELETE' })
                            .then(r => r.json())
                            .then(data => {
                                alert(data.message);
                                location.href = data.redirect;
                            })
                            .catch(err => alert(err.message));
                    }
                });
            }
        </script>

        <%- include('../layout/footer') %>