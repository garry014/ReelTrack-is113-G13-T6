<%- include('../layout/base', { pageTitle: 'Filter Movies by Genre' }) %>
    <%- include('../layout/header') %>

        <div class="container-sm" style="padding-top: 2.5rem; padding-bottom: 4rem;">
            <div class="mb-md fade-in-up">
                <span class="section-label">Browse</span>
                <h1 style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px;">Filter Movies by Genre</h1>
                <p class="text-muted text-sm mt-sm">Select a genre to view matching movies.</p>
            </div>

            <div class="card fade-in-up" style="animation-delay: 0.1s; margin-bottom: 2rem;">
                <form action="/movies/filter" method="GET">
                    <div class="form-group">
                        <label for="genre">Genre</label>
                        <select name="genre" id="genre" required>
                            <option value="" disabled <%=!selectedGenre ? 'selected' : '' %>>Select genre...</option>
                            <% allGenres.forEach((genre)=> { %>
                                <option value="<%= genre.name %>" <%=selectedGenre===genre.name ? 'selected' : '' %>>
                                    <%= genre.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                        <a href="/movies" class="btn btn-ghost">Back</a>
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>
                </form>
            </div>

            <% if (selectedGenre) { %>
                <section class="movies-section fade-in-up" style="animation-delay: 0.15s;">
                    <span class="section-label">Results</span>
                    <h2>Movies under <%= selectedGenre %>
                    </h2>
                    <div class="section-divider"></div>

                    <% if (allMovies.length===0) { %>
                        <div class="empty-state">
                            <div class="empty-icon">🎬</div>
                            <h3>No movies found</h3>
                            <p>No movies currently belong to this genre.</p>
                        </div>
                        <% } else { %>
                            <div class="movies-container">
                                <% allMovies.forEach((movie)=> { %>
                                    <a href="/movies/<%= movie._id %>" class="movie-card" id="movie-<%= movie._id %>">
                                        <img src="<%= movie.posterUrl %>" alt="<%= movie.title %> poster" loading="lazy"
                                            onerror="this.onerror=null;this.src='/img/poster-not-available.webp';">
                                        <div class="movie-card-info">
                                            <p class="movie-card-title">
                                                <%= movie.title %>
                                            </p>
                                            <p class="movie-card-meta">
                                                <%= movie.duration %> mins · <%= movie.genre %>
                                            </p>
                                        </div>
                                    </a>
                                    <% }) %>
                            </div>
                            <% } %>
                </section>
                <% } %>
        </div>

        <%- include('../layout/footer') %>