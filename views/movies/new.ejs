<%- include('../layout/base', { pageTitle: 'Add a Movie' }) %>
    <%- include('../layout/header') %>

        <div class="container-sm" style="padding-top: 2.5rem; padding-bottom: 4rem;">
            <div class="mb-md fade-in-up">
                <span class="section-label">Admin</span>
                <h1 style="font-size: 1.9rem; font-weight: 900; letter-spacing: -0.5px;">Add a New Movie</h1>
                <p class="text-muted text-sm mt-sm">Fill in the details below to publish a movie to ReelTrack.</p>
            </div>
            <% if(inputError.length > 0){ %>
                <p style="color:red"><%= inputError.join(', ') %></p>
            <% } %>
            <div class="card fade-in-up" style="animation-delay: 0.1s;">
                <form action="/movies/new" method="POST" id="add-movie-form">
                    <div class="form-group">
                        <label for="title">Title</label>
                        <input type="text" id="title" name="title" placeholder="e.g. Interstellar" 
                        value="<%= formValues ? formValues.title : '' %>" required>
                    </div>
                    <div class="form-group">
                        <label for="director">Director</label>
                        <input type="text" id="director" name="director" placeholder="e.g. Christopher Nolan" 
                        value="<%= formValues ? formValues.director : '' %>" required>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label for="releaseYear">Release Year</label>
                            <input type="number" id="year" name="releaseYear" placeholder="2024" 
                            value="<%= formValues ? formValues.releaseYear : '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="duration">Duration (mins)</label>
                            <input type="number" id="duration" name="duration" placeholder="120" 
                            value="<%= formValues ? formValues.duration : '' %>" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="genre">Genre</label>
                        <select id="genre" name="genre" required>
                            <option value="" disabled selected>Select genre…</option>
                            <% allActiveGenre.forEach((genre) => { %>
                                <option value="<%= genre.name %>" 
                                <%= formValues?.genre === genre.name? 'selected':'' %> ><%= genre.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="posterUrl">Poster URL</label>
                        <input type="url" id="poster" name="posterUrl" placeholder="https://…"
                        value="<%= formValues ? formValues.posterUrl : '' %>" required>
                    </div>
                    <div class="form-group">
                        <label for="synopsis">Synopsis</label>
                        <textarea id="synopsis" name="synopsis" rows="5" placeholder="Brief description of the movie…"
                         required><%= formValues ? formValues.synopsis : '' %></textarea>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 0.5rem;">
                        <a href="/movies" class="btn btn-ghost" id="cancel-add">Cancel</a>
                        <button type="submit" class="btn btn-primary" id="submit-movie">🎬 Publish Movie</button>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../layout/footer') %>